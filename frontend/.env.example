# ======================================================
# GitPulse — Frontend environment variables (Vite)
# Copy this file to ".env" only if you need to change defaults.
# ======================================================

# Base URL of the GitPulse backend REST API.
# Every request from the React app goes here — the frontend never calls GitHub directly.
VITE_API_URL=http://localhost:5000/api

# Optional: brand label shown in the sidebar (nice for a college demo)
VITE_APP_NAME=GitPulse