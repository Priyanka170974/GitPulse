# ======================================================
# GitPulse — Frontend environment variables (Vite)
# Copy this file to ".env" only if you need to change defaults.
# ======================================================

# Base URL of the GitPulse backend REST API.
# Every request from the React app goes here — the frontend never calls GitHub directly.
#
#   LOCAL DEVELOPMENT (.env on your machine):
#     VITE_API_URL=http://localhost:5000/api
#
#   PRODUCTION — set this in the Vercel project settings
#   (Settings → Environment Variables), then redeploy:
#     VITE_API_URL=https://gitpulse-api-s2dw.onrender.com
#
# Both forms work: the "/api" suffix is added automatically when missing, and
# never doubled when present. When this variable is absent a production build
# falls back to the deployed Render URL, and a dev build falls back to
# http://localhost:5000/api — so a Vercel build can never point at localhost.
VITE_API_URL=http://localhost:5000/api

# Optional: brand label shown in the sidebar (nice for a college demo)
VITE_APP_NAME=GitPulse