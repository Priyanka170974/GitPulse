# ======================================================
# GitPulse — Backend environment variables (Node/Express)
# ======================================================
# Copy to ".env" for local development:
#     copy .env.example .env
#
# On Render these SAME variables go into
#   Dashboard → your service → Environment
# NEVER commit a real .env, and never put secrets in frontend VITE_ variables
# (everything prefixed VITE_ is baked into the public browser bundle).
# ======================================================


# ---------- Required ----------

# MongoDB Atlas connection string.
# Service → Cluster → Connect → Drivers → copy the mongodb+srv:// string.
# Render: set it as an Environment Variable. Locally: paste here.
# Example shape (do not commit a real one):
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGO_URI=

# Secret used to sign JWTs. Use a long random string.
# Locally you can generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# GitHub personal access token used for all GitHub API calls.
#
#   For repository CLONE/traffic statistics GitHub requires a FINE-GRAINED
#   token that selects the repository and grants "Administration: Read".
#   A classic token can read public data but NEVER traffic data.
GITHUB_TOKEN=


# ---------- CORS / deployment ----------

# Origin(s) allowed to call this API, comma-separated. No trailing slash.
#
#   PRODUCTION (Render) — the deployed frontend:
#     CLIENT_URL=https://git-pulse-phi.vercel.app
#
#   LOCAL — the Vite dev server:
#     CLIENT_URL=http://localhost:5174
#
#   Several at once:
#     CLIENT_URL=https://git-pulse-phi.vercel.app,http://localhost:5174
#
# If CLIENT_URL is unset in production the server logs a warning and rejects
# every browser origin — the deployed frontend then shows
# "Could not reach the GitPulse API".
CLIENT_URL=http://localhost:5174


# ---------- Optional ----------

# API port. Render sets PORT automatically — do not hardcode it.
PORT=5000

# JWT lifetime for login sessions.
JWT_EXPIRES_IN=7d

# Only change this for GitHub Enterprise or a local mock.
# GITHUB_API_URL=https://api.github.com

# DNS resolvers used for Atlas SRV lookups (blank = built-in fallback,
# "system" = let the OS resolve). Helps when querySrv is refused.
# DNS_SERVERS=8.8.8.8,1.1.1.1
