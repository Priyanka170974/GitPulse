{
  "name": "gitpulse-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GitPulse API — GitHub repository intelligence & analytics service (MERN)",
  "main": "src/bootstrap.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/bootstrap.js",
    "dev": "node --watch src/bootstrap.js",
    "seed:admin": "node src/scripts/createAdmin.js",
    "smoke": "node src/scripts/smokeTest.js",
