# ==========================================
#  GitPulse — ignore rules
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.vite/
.cache/

# Environment variables (NEVER commit real secrets)
.env
.env.local
.env.*.local
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp

# Test / coverage
coverage/
.nyc_output/

# Misc
.cache/
.temp/
tmp/
npm-debug.log*




node_modules/
.env
.env.*
!.env.example
dist/
coverage/
